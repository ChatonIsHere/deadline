{
    "name": "deadline",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "Gig board bot for a Cyberpunk RED campaign",
    "scripts": {
        "build": "npm run build:client && npm run build:server",
        "build:client": "vite build --config client/vite.config.ts",
        "build:server": "nest build",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "typecheck": "tsc --noEmit && tsc --noEmit -p client",
        "test": "tsc -p tsconfig.spec.json && node --test \"dist-test/**/*.spec.js\"",
        "db:generate": "drizzle-kit generate",
        "emoji": "node scripts/draw-emoji.js"
    },
    "dependencies": {
        "@nestjs/common": "^11.2.8",
        "@nestjs/core": "^11.2.8",
        "@nestjs/platform-express": "^11.2.8",
        "@resvg/resvg-js": "^2.6.2",
        "better-sqlite3": "^12.11.1",
        "cmdk": "^1.1.1",
        "cookie-parser": "^1.4.7",
        "discord.js": "^14.28.1",
        "drizzle-orm": "^0.45.4",
        "helmet": "^8.3.0",
        "necord": "^6.14.0",
        "react-easy-crop": "^6.2.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource/chakra-petch": "^5.3.0",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-query": "^5.106.1",
        "@tiptap/core": "^3.32.3",
        "@tiptap/markdown": "^3.32.3",
        "@tiptap/pm": "^3.32.3",
        "@tiptap/react": "^3.32.3",
        "@tiptap/starter-kit": "^3.32.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "drizzle-kit": "^0.31.11",
        "lucide-react": "^1.69.0",
        "marked": "^18.1.3",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^7.18.5",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.4",
        "typescript": "^5.9.3",
        "vite": "^7.3.7"
    }
}
