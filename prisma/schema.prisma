// Deadline's database. Postgres on db-data-01 in production, the local Docker one in dev.
// Tables and columns are snake_case in the database, camelCase in code.
// Some checks Prisma can't express (stars 1 to 5, pay above 0 once out of draft, a single settings
// row) are added by hand in the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GigStatus {
  /// Saved but not sent in. Only its author and admins can see it.
  draft
  pending
  open
  closed
  completed
  cancelled
  rejected

  @@map("gig_status")
}

/// Whether a runner still takes gigs. Retired is a break (they can come back), dead is for good.
enum RunnerStatus {
  active
  retired
  dead

  @@map("runner_status")
}

/// Where a runner in a slot stands. Only "interested" until a session time is set.
enum RunnerState {
  interested
  awaiting
  confirmed

  @@map("runner_state")
}

/// gig: a 16:9 post picture. avatar: a square runner picture. art: a runner's full art, any shape.
enum ImageKind {
  gig
  avatar
  art

  @@map("image_kind")
}

/// monthly: from where and how they live. gig: for finishing a gig. spend: a player recording what they spent. admin: added by hand.
enum DowntimeKind {
  monthly
  gig
  spend
  admin

  @@map("downtime_kind")
}

/// One row (id 1), set from the web Settings page.
model Settings {
  id               Int     @id @default(1)
  guildId          String? @map("guild_id")
  forumId          String? @map("forum_id")
  adminRoleId      String? @map("admin_role_id")
  fixerRoleId      String? @map("fixer_role_id")
  edgerunnerRoleId String? @map("edgerunner_role_id")
  /// Day-of reminder, hours before a session
  reminderHours    Int     @default(8) @map("reminder_hours")
  /// How long runners get to confirm a session time
  confirmHours     Int     @default(48) @map("confirm_hours")
  /// Roles runners can pick (string[]). Starts as RED's core ten.
  runnerRoles      Json    @default("[]") @map("runner_roles")
  /// How many live gigs a player can be signed up to, across all their runners. 0 is no limit.
  maxSignups       Int     @default(0) @map("max_signups")

  @@map("settings")
}

/// Per-person choices. No row means the defaults.
model UserPrefs {
  userId       String    @id @map("user_id")
  reminders    Boolean   @default(true)
  /// Which other notifications they get by DM (see NotifySettings). Missing keys use the defaults.
  notify       Json      @default("{}")
  /// The bot owner browsing as a normal player, admin powers hidden
  playerView   Boolean   @default(false) @map("player_view")
  /// Their timezone, e.g. "Europe/London". Times on the web show in it.
  timezone     String?
  /// Hours of the week they can usually play (number[], 0 to 167, 0 is Monday 00:00), on their own clock
  availability Json      @default("[]")
  /// When they finished first-time setup (a runner, a timezone, reminders or not)
  setupAt      DateTime? @map("setup_at") @db.Timestamptz

  @@map("user_prefs")
}

/// A crew of runners. Whoever holds its top rank (Founder by default) runs it.
model Crew {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// One of a kind, compared as links compare them (see slug)
  name      String   @unique
  /// The crew's link, made from the name: /crews/static-wolves
  slug      String   @unique
  tagline   String   @default("")
  /// A square picture
  imageId   String?  @map("image_id") @db.Uuid
  /// The player who made it. Kept for the record; the top rank runs the crew.
  ownerId   String   @map("owner_id")
  /// Rank names (string[]), highest first. The first is the founder rank.
  ranks     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  image   Image?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  members CrewMember[]
  allies  CrewAlly[]
  invites CrewInvite[]
  slots   GigSlot[]

  @@index([imageId])
  @@map("crews")
}

model CrewMember {
  crewId   String @map("crew_id") @db.Uuid
  runnerId String @map("runner_id") @db.Uuid
  /// One of the crew's ranks, by name
  rank     String

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@id([crewId, runnerId])
  @@index([runnerId])
  @@map("crew_members")
}

/// Runners a crew knows and trusts, without them being members.
model CrewAlly {
  crewId   String @map("crew_id") @db.Uuid
  runnerId String @map("runner_id") @db.Uuid

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@id([crewId, runnerId])
  @@index([runnerId])
  @@map("crew_allies")
}

/// A crew asking a runner to join. Their player accepts or declines (DM or web).
model CrewInvite {
  crewId    String   @map("crew_id") @db.Uuid
  runnerId  String   @map("runner_id") @db.Uuid
  invitedBy String   @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@id([crewId, runnerId])
  @@index([runnerId])
  @@map("crew_invites")
}

/// A character. Players can have several. One with the Fixer role counts as a fixer only while
/// its player has the Discord fixer role. NPC fixers are added by admins and have no player.
model Runner {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The player. Empty for NPC fixers.
  ownerId        String?      @map("owner_id")
  /// One of a kind in Night City, compared as links compare them (see slug)
  handle         String
  /// The runner's link, made from the handle: /runners/vex
  slug           String       @unique
  role           String
  /// More roles (string[])
  extraRoles     Json         @default("[]") @map("extra_roles")
  imageId        String?      @map("image_id") @db.Uuid
  /// One line under their name
  tagline        String?
  /// About the character. Markdown. Shown on the runner and fixer profiles.
  bio            String?
  /// Where they live and how (see shared/downtime.ts). Private to their player and admins.
  living             String?
  lifestyle          String?
  /// The numbers when living is "custom": a shared or owned place
  customLiving       Json?   @map("custom_living")
  /// The last DT month ("2026-11") they were paid for
  downtimeGrantedFor String? @map("downtime_granted_for")
  /// The DT month they last finished a gig in, which decides whether they can skip a month
  lastGigMonth       String? @map("last_gig_month")
  // Fixer profile
  /// The name they go by as a fixer, if not their handle. Shown on the fixer side only.
  fixerAlias     String?      @map("fixer_alias")
  /// The fixer profile's link, made from the alias: /fixers/mr-hands. Shares the handles' namespace.
  fixerSlug      String?      @unique @map("fixer_slug")
  officeLocation String?      @map("office_location")
  specialties    String?
  contact        String?
  status         RunnerStatus @default(active)
  /// When they retired or died
  retiredAt      DateTime?    @map("retired_at") @db.Timestamptz(3)
  /// How a dead runner went out. Markdown.
  obituary       String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  image       Image?       @relation("RunnerPicture", fields: [imageId], references: [id], onDelete: SetNull)
  photos      RunnerPhoto[]
  memberships CrewMember[]
  allyOf      CrewAlly[]
  invites     CrewInvite[]
  fixedGigs   Gig[]
  slots       GigSlot[]
  reserves    GigReserve[]
  rewards     GigReward[]
  downtime    DowntimeEntry[]

  @@index([ownerId])
  @@index([imageId])
  @@map("runners")
}

model Gig {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  /// The fixer's name: their character's handle, or what an admin typed for a one-off NPC
  fixerName          String    @map("fixer_name")
  fixerRunnerId      String?   @map("fixer_runner_id") @db.Uuid
  /// The fixer character's player, if they have one
  fixerId            String?   @map("fixer_id")
  location           String
  type               String?
  /// Everything about the job. The Discord post's description.
  brief              String
  /// What the crew has to do to get paid: one or more parts (string[]), one payout
  primaryObjective   Json      @default("[]") @map("primary_objective")
  /// What the primary objective pays. The gig's pay runs from this to this plus every bonus.
  pay                Int
  /// Pay is one pot divided between the runners, rather than this much each
  splitPay           Boolean   @default(false) @map("split_pay")
  imageId            String?   @map("image_id") @db.Uuid
  /// Storage key of the current gig card (the picture with the name on it) for Discord
  cardKey            String?   @map("card_key")
  status             GigStatus @default(pending)
  createdBy          String    @map("created_by")
  /// Forum post. In a forum the starter message shares the thread's ID.
  threadId           String?   @unique @map("thread_id")
  /// Thread messages carrying whatever didn't fit in the post's first message (string[])
  overflowMessageIds Json      @default("[]") @map("overflow_message_ids")
  /// When the session is played. Until then runners are only "interested".
  sessionAt          DateTime? @map("session_at") @db.Timestamptz(3)
  /// Reminders already sent for the current session time
  remindedDay        Boolean   @default(false) @map("reminded_day")
  remindedSoon       Boolean   @default(false) @map("reminded_soon")
  /// A draft an admin has scheduled: it posts at this time, as them
  postAt             DateTime? @map("post_at") @db.Timestamptz(3)
  postBy             String?   @map("post_by")
  // Filled in when an admin completes the gig. These rewards go to everyone on it.
  summary            String?
  rewardEb           Int?      @map("reward_eb")
  rewardIp           Int?      @map("reward_ip")
  rewardHqIp         Int?      @map("reward_hq_ip")
  rewardText         String?   @map("reward_text")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  fixerRunner Runner?        @relation(fields: [fixerRunnerId], references: [id], onDelete: SetNull)
  image       Image?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  objectives  GigObjective[]
  slots       GigSlot[]
  reserves    GigReserve[]
  rewards     GigReward[]
  ratings     FixerRating[]

  @@index([status])
  @@index([fixerRunnerId])
  @@index([imageId])
  @@map("gigs")
}

/// Secondary objectives. The primary one is on the gig.
model GigObjective {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gigId    String  @map("gig_id") @db.Uuid
  text     String
  bonus    Int?
  /// Paid for each time it's done ("x for each y"), not once on completion
  each     Boolean @default(false)
  /// Shown to players as "not disclosed" until the gig begins (sign-ups lock)
  hidden   Boolean @default(false)
  position Int

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@map("gig_objectives")
}

/// One row per slot. No crew means anyone can take it. No player means it's empty.
model GigSlot {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gigId    String      @map("gig_id") @db.Uuid
  crewId   String?     @map("crew_id") @db.Uuid
  /// The player (one runner each per gig) and which of their runners is going
  userId   String?     @map("user_id")
  runnerId String?     @map("runner_id") @db.Uuid
  /// Only meaningful while userId is set
  state    RunnerState @default(interested)
  /// When an awaiting runner was asked to confirm, and whether they've been nudged since
  askedAt  DateTime?   @map("asked_at") @db.Timestamptz(3)
  nudged   Boolean     @default(false)
  position Int
  /// No limit on this group of slots (the gig's crew, or anyone). It always keeps one empty slot to sign up to.
  unlimited Boolean    @default(false)

  gig    Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)
  runner Runner? @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([gigId])
  @@index([userId])
  @@index([runnerId])
  @@map("gig_slots")
}

/// Runners waiting for a slot, first come first served.
model GigReserve {
  gigId    String   @map("gig_id") @db.Uuid
  userId   String   @map("user_id")
  runnerId String   @map("runner_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  gig    Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@id([gigId, userId])
  @@index([runnerId])
  @@map("gig_reserves")
}

/// Extra rewards for one runner, on top of the crew's.
model GigReward {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gigId    String  @map("gig_id") @db.Uuid
  runnerId String  @map("runner_id") @db.Uuid
  eb       Int?
  ip       Int?
  hqIp     Int?    @map("hq_ip")
  text     String?
  /// Their cut of the pot, on a gig with overall pay
  share    Int?

  gig    Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@unique([gigId, runnerId])
  @@index([runnerId])
  @@map("gig_rewards")
}

/// A picture in a runner's gallery. Any shape. Lowest position shows first.
model RunnerPhoto {
  runnerId String @map("runner_id") @db.Uuid
  imageId  String @map("image_id") @db.Uuid
  position Int

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  image  Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([runnerId, imageId])
  @@index([imageId])
  @@map("runner_photos")
}

/// A change to a runner's downtime. A month's balance is that month's entries added up.
model DowntimeEntry {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runnerId  String       @map("runner_id") @db.Uuid
  /// The DT month it belongs to, "2026-11". Turns over at noon on the 1st, the player's time.
  month     String
  /// Negative for spending
  amount    Int
  kind      DowntimeKind
  note      String?
  /// Month start only: what's due and the humanity change, as they were that month
  rent      Int?
  humanity  Int?
  /// Month start only: no game the month before, so it can be skipped
  skippable Boolean      @default(false)
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, month])
  @@map("downtime_entries")
}

/// A player's star rating (1 to 5) for a gig's fixer, given after the gig.
model FixerRating {
  gigId   String   @map("gig_id") @db.Uuid
  userId  String   @map("user_id")
  stars   Int
  comment String?
  ratedAt DateTime @default(now()) @map("rated_at") @db.Timestamptz(3)

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@id([gigId, userId])
  @@map("fixer_ratings")
}

/// Night City districts and areas, suggested for gig locations. Seeded on first start.
model Region {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String  @unique
  /// The district an area belongs to. Empty for districts themselves.
  district String?

  images Image[]

  @@map("regions")
}

/// Pictures for gig posts and runners. Library ones get picked at random: the region's own,
/// then its district's, then the general pool (no region). The files live in object storage
/// under images/<id>/.
model Image {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId    String?   @map("region_id") @db.Uuid
  inLibrary   Boolean   @map("in_library")
  kind        ImageKind @default(gig)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// What all its stored files take up, for the limit per person
  bytes       Int       @default(0)
  /// When nothing (gig, runner, library) used it any more. Deleted 30 days after.
  unusedSince DateTime? @map("unused_since") @db.Timestamptz(3)

  region  Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  gigs    Gig[]
  runners Runner[] @relation("RunnerPicture")
  artOf   RunnerPhoto[]
  crews   Crew[]

  @@index([regionId])
  @@index([unusedSince])
  @@map("images")
}

/// Stored files no longer used (old gig cards, old frame versions), deleted 30 days after.
model StaleObject {
  key   String   @id
  since DateTime @default(now()) @db.Timestamptz(3)

  @@map("stale_objects")
}
