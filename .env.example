# Server
# production serves the built client. development runs Vite with reload.
NODE_ENV=development
PORT=3003
PUBLIC_URL=http://localhost:3003

# Database and cache. These match docker-compose.yml (docker compose up -d).
DATABASE_URL=postgresql://deadline:deadline@localhost:5433/deadline
# Leave empty to cache in memory (sessions are then lost on restart)
REDIS_URL=redis://localhost:6380/0

# Pictures. Leave these empty to keep them in ./data/objects instead.
S3_ENDPOINT=
S3_REGION=eu-central
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# How much picture storage one person's uploads can take up, in MB. 100 if left out.
# MAX_USER_STORAGE_MB=100

# Discord app (developer portal > your app). The server, forum and roles are picked on the web.
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
