# Server
# production serves the built client. development runs Vite with reload.
NODE_ENV=development
PORT=3003
PUBLIC_URL=http://localhost:3003

# Database and cache. These match docker-compose.yml (docker compose up -d).
DATABASE_URL=postgresql://deadline:deadline@localhost:5433/deadline
# Leave empty to cache in memory (sessions are then lost on restart)
REDIS_URL=redis://localhost:6380/0

# Pictures. Leave these empty to keep them in ./data/objects instead.
S3_ENDPOINT=
S3_REGION=eu-central
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# How much picture storage one person's uploads can take up, in MB. 100 if left out.
# MAX_USER_STORAGE_MB=100

# Limits. Each shows its default; 0 turns it off. Admins aren't held to the per-person ones.
# Active runners per player (retired and flatlined ones don't count)
# MAX_ACTIVE_RUNNERS=5
# Crews a player can found, crews one runner can be in, and the size of a crew
# MAX_CREWS_FOUNDED=2
# MAX_CREWS_PER_RUNNER=3
# MAX_CREW_MEMBERS=30
# MAX_CREW_ALLIES=50
# Invites a crew can have waiting, and how long before asking a runner who said no again
# MAX_PENDING_INVITES=10
# INVITE_COOLDOWN_DAYS=7
# Drafts per fixer, and gigs a fixer can have waiting for approval
# MAX_DRAFTS=10
# MAX_PENDING_GIGS=5
# Live gigs per runner (reserves included), used when the Settings page leaves it at 0
# MAX_SIGNUPS=3
# How long after pulling out of a gig before signing up to it again
# REJOIN_COOLDOWN_MINUTES=10
# Crew logo frame changes per crew per day, and picture uploads per person per day
# MAX_FRAME_CHANGES_PER_DAY=6
# MAX_UPLOADS_PER_DAY=30
# Saves and other changes per person per minute
# MAX_WRITES_PER_MINUTE=60
# Most a gig can pay (and an objective bonus or reward can be), in eb, and the most IP one reward can give.
# These apply to admins too.
# MAX_PAY=1000000
# MAX_IP=1000

# Discord app (developer portal > your app). The server, forum and roles are picked on the web.
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
